# Copy to .env and fill in. See shivyan/settings.py for all variables.
# Never commit a filled .env to git.

# local | production — production turns off DEBUG and expects real DOMAIN / HTTPS settings
ENVIRONMENT=production

# Required in production: long random value (e.g. openssl rand -hex 32)
SECRET_KEY=

# False in production
DEBUG=False

# Your domain(s), comma-separated, no spaces
# ALLOWED_HOSTS=www.example.com,example.com
ALLOWED_HOSTS=127.0.0.1,localhost

# Full URLs including scheme — required for HTTPS sites (Django 4+)
# CSRF_TRUSTED_ORIGINS=https://www.example.com,https://example.com
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Static & media (URLs are normalized with trailing /). Optional full CDN, e.g.:
#   STATIC_URL=https://cdn.example.com/assets/
#   MEDIA_URL=/media/  (default)
# Folders: empty = under project; or absolute path, or path relative to project root
# STATIC_URL=/static/
# STATIC_ROOT=staticfiles
# MEDIA_URL=/media/
# MEDIA_ROOT=media

# sqlite (default) or mysql (uses PyMySQL; run migrations after switch)
DB_ENGINE=sqlite

# If DB_ENGINE=mysql: create the database as utf8mb4 before migrate (Nepali / Devanagari)
#   CREATE DATABASE yourdb CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
# Optional; default utf8mb4_unicode_ci. MySQL 8.0+ servers often use utf8mb4_0900_ai_ci
# MYSQL_COLLATION=utf8mb4_unicode_ci

# Where contact form copies go (Shivyan team)
CONTACT_INBOX_EMAIL=

# SMTP — production example (Gmail: enable 2FA and create an App Password for EMAIL_HOST_PASSWORD)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Sender shown to customers; for Gmail, usually matches EMAIL_HOST_USER
DEFAULT_FROM_EMAIL=
SERVER_EMAIL=

# --- Blog newsletter (uses same SMTP as EMAIL_* above) ---
# Public site URL (no trailing slash) — links in new-post and welcome emails. Falls back to ALLOWED_HOSTS.
# NEWSLETTER_BASE_URL=https://www.example.com
# Inbox for “Reply” on newsletter email (optional; e.g. contact@yoursite.com)
# NEWSLETTER_REPLY_TO=
# Override the visible sender name; default is your SiteSettings company name in Django admin
# NEWSLETTER_FROM_NAME=Shivyan Blog
# Where new subscriber notifications go (defaults to CONTACT_INBOX_EMAIL)
# NEWSLETTER_INBOX_EMAIL=
# Send a one-time “you’re subscribed” message when someone joins the list (true/false)
# NEWSLETTER_SEND_WELCOME_EMAIL=True

# Logging
LOG_LEVEL=INFO

# After HTTPS reverse proxy (nginx) terminates TLS, keep defaults unless you need:
# USE_PROXY_SSL_HEADER=True
# SECURE_SSL_REDIRECT=True
# (Applied automatically when DEBUG=False in settings; override via env in settings if you add them)
